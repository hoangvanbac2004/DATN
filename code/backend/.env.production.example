# ===================================================================
# TaskFlow Backend — Production Environment Variables
# ===================================================================
# Copy these to Railway Dashboard > Variables
# DO NOT commit this file with real values to Git!
# ===================================================================

# Database (Railway auto-fills these when you add PostgreSQL plugin)
DATABASE_URL=jdbc:postgresql://<host>:<port>/<dbname>
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=<your-db-password>

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# JWT Secret (generate with: openssl rand -base64 64)
JWT_SECRET=<your-very-long-random-jwt-secret-at-least-64-characters>
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Server Port (Railway sets this automatically via PORT env var)
PORT=8080

# CORS - set to your Vercel frontend URL after deploying
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
